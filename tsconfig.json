{
  "compilerOptions": {
    "target": "ES2022",

    // The package is "type": "module", so the emitted dist/ must be real ESM.
    // nodenext resolution is what makes tsc enforce Node's actual ESM rules —
    // notably that relative imports carry the emitted `.js` extension. Under
    // "bundler" resolution tsc accepts extensionless specifiers and emits them
    // verbatim, which Node then rejects at load with ERR_MODULE_NOT_FOUND.
    "module": "nodenext",
    "moduleResolution": "nodenext",

    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true
  },
  "include": ["src"],
  // src/test/panel is excluded for the same reason as src/configpanel: it
  // renders the panel, so it is JSX against DOM types. It has its own build
  // (src/test/panel/tsconfig.json → dist-panel-test/, run by `test:panel`).
  // Letting it in here would force `jsx` and a DOM lib into the Node compile,
  // which is precisely what keeps server code from referencing `document`.
  "exclude": ["node_modules", "dist", "src/configpanel", "src/test/panel"]
}

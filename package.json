{
  "name": "signalk-questdb",
  "version": "1.9.2",
  "type": "module",
  "description": "QuestDB history provider for Signal K — replaces signalk-to-influxdb",
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-plugin-configurator",
    "signalk-embeddable-webapp",
    "signalk-category-database"
  ],
  "signalk": {
    "displayName": "QuestDB History",
    "appIcon": "app-icon.svg",
    "screenshots": [
      "./doc/screenshots/signalk-questdb-1.png"
    ],
    "requires": [
      "signalk-container"
    ]
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npm run typecheck:panel && vite build",
    "build:config": "vite build",
    "typecheck:panel": "tsc -p src/configpanel --noEmit",
    "watch": "tsc --watch",
    "prettier": "prettier --write .",
    "lint": "eslint --fix",
    "format": "npm run prettier && npm run lint",
    "ci-lint": "eslint && prettier --check .",
    "test": "node --test 'dist/test/**/*.test.js'",
    "build:all": "npm run build && npm test && npm run test:panel",
    "prepublishOnly": "npm run build",
    "build:panel-test": "tsc -p src/test/panel/tsconfig.json",
    "test:panel": "npm run build:panel-test && node --test \"dist-panel-test/src/test/panel/**/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "author": "Dirk Wahrheit <dirkwahrheit@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dirkwa/signalk-questdb"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.0",
    "minimatch": "^10.2.3",
    "signalk-container-helper": "^0.4.3",
    "typebox": "^1.3.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@module-federation/vite": "^1.20.4",
    "@signalk/server-api": "latest",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.4.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.2.1"
  }
}
